# Ignore object files and compiled binaries
*.o
*.out
*.a
*.so
*.exe

# Ignore dependency files
*.d

# Ignore build directories
/build/
/bin/
/obj/
/lib/
/target/ # Rust build directory

# Ignore editor/IDE temporary files
*.swp
*.swo
*~
*.tmp
*.log
cargo-crash.log
.idea/ # IntelliJ IDEA project files
.vscode/ # VS Code project files
*.iml

# Ignore core dumps
core

# Ignore deleted files
*.delete

# Ignore JSON files
*.json

# Ignore other common temporary or system files
.DS_Store
Thumbs.db

# Ignore Flycheck files
flycheck*/
.flycheck*/

# Ignore Rust-specific files
/target/ # Cargo build directory
**/Cargo.lock # Lock file for dependencies (if not tracked)
/*.rs.bk # Backup files for Rust source code

# Ignore Node.js files (if applicable)
/node_modules/
/npm-debug.log*
/yarn-error.log*

# Ignore Python virtual environments (if applicable)
/venv/
/.env
*.pyc
__pycache__/

# Ignore logs and temporary files
*.log
*.bak
*.tmp

# Ignore macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Ignore Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# Ignore Linux system files
*~