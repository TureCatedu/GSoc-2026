# Ignore object files and compiled binaries
*.o
*.out
*.a
*.so
*.exe

# Ignore dependency files
*.d

# Ignore build directories
/build/
/bin/
/obj/
/lib/

# Ignore editor/IDE temporary files
*.swp
*.swo
*~
*.tmp
*.log

# Ignore core dumps
core

# Ignore Makefile-specific temporary files
Makefile.bak

# --- RUST & CARGO ---
rust_core/target/
**/*.rs.bk
Cargo.lock

# --- RUBY & BUNDLER ---
*.gem
.bundle/
vendor/bundle/
*.rbc

# --- macOS ---
.DS_Store

# --- VS CODE ---
.vscode/
